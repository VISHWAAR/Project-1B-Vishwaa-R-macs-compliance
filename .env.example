# LLM Provider (set ONE)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# LLM Models (optional overrides)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GROQ_MODEL=openai/gpt-oss-20b

# Agent Configuration
MAX_CONCURRENT_AGENTS=4
AGENT_TIMEOUT_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=30

# Escalation
ESCALATION_SLA_TIER1_SECONDS=900
ESCALATION_SLA_TIER2_SECONDS=3600
ESCALATION_SLA_TIER3_SECONDS=14400
ESCALATION_SLA_TIER4_SECONDS=43200

# Observability
LOG_RETENTION_YEARS=7
AUDIT_HASH_ALGORITHM=sha256
LOG_LEVEL=INFO

# Consensus
CONSENSUS_MIN_CONFIDENCE=0.3
CONSENSUS_MAX_CONFLICTS=3
